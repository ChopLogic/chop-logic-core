{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm ci)",
			"Bash(npm run typecheck)",
			"Bash(npm run lint)",
			"Bash(npm run lint:*)",
			"Bash(npm run test:ci*)",
			"Bash(npm run test:coverage*)",
			"Bash(npm run build)",
			"Bash(npm run docs)",
			"Bash(npx jest *)",
			"Bash(npx biome *)",
			"Bash(npx tsc *)"
		],
		"deny": [
			"Bash(npm publish*)",
			"Bash(npm run release:version*)",
			"Bash(git push*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.mjs\"",
						"timeout": 30
					}
				]
			}
		]
	}
}
